{
  "name": "bloom-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm --filter @bloom/web test",
    "compose:up": "docker compose up -d --wait",
    "compose:down": "docker compose down -v",
    "smoke": "bash tests/e2e/smoke.sh"
  },
  "devDependencies": {
    "@bloom/adapter-crm": "workspace:*",
    "@bloom/adapter-email": "workspace:*",
    "@bloom/adapter-scan-engine": "workspace:*",
    "@bloom/db": "workspace:*",
    "@bloom/interfaces": "workspace:*",
    "@bloom/svc-agents": "workspace:*",
    "@bloom/svc-approval": "workspace:*",
    "@bloom/svc-config": "workspace:*",
    "@bloom/svc-credits": "workspace:*",
    "@bloom/svc-workflow": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
