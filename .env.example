# Bloom v1.0 scaffold — copy to .env for local development.
# All values are placeholders; real credentials ship via the secrets flow, never in git.

# Postgres (docker compose: postgres service)
DATABASE_URL=postgres://bloom:bloom@localhost:5432/bloom

# Service ports (docker compose sets these per container)
BLOOM_WEB_PORT=3000
BLOOM_WORKFLOW_PORT=4101
BLOOM_APPROVAL_PORT=4102
BLOOM_AGENTS_PORT=4103

# Scan engine selection (spec decision 3: Obvious primary, Deepline fallback)
SCAN_ENGINE_PRIMARY=obvious
SCAN_ENGINE_FALLBACK=deepline
